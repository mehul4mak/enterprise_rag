# BACKEND: which provider implementations to use.
#   local = PyMuPDF + FAISS/BM25 + cross-encoder + Gemini/Ollama (Phase 1 & 2, runs anywhere)
#   gcp   = Document AI + Vertex Vector Search/Ranking + Gemini-on-Vertex (Phase 3 target; stubs today)
BACKEND=local

# PDF parser (local backend): pymupdf (fast default) | pdfplumber | docling | easyocr | vlm
# pdfplumber keeps labels next to their numbers best on slide decks (see PARSING.md).
# Non-pymupdf parsers need: pip install -r requirements-parsers.txt
PARSER=pymupdf

# --- Governance / safety (Phase 2+) ---
# GUARDRAILS + MODEL_ARMOR: on|off — input prompt-injection screen + output PII redaction.
GUARDRAILS=on
MODEL_ARMOR=on
# DATA_RESIDENCY: off | regional | strict.  strict = data must stay on-box → only LLM_PROVIDER=ollama
# is allowed; external APIs (gemini/openai/anthropic) are blocked at ingest time.
DATA_RESIDENCY=off

# LLM_PROVIDER: ollama (default, local, no key needed) | openai | anthropic | gemini
LLM_PROVIDER=ollama

# Used only when LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma2:2b
OLLAMA_HOST=http://localhost:11434

# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Used only when LLM_PROVIDER=gemini
# Model availability depends on the KEY's project age: newly-created keys can ONLY use the
# newest (3.x) models — 2.x return 404 "no longer available to new users". The *-latest
# aliases always resolve to a model your key can use, so prefer them:
#   gemini-flash-lite-latest  (fast, cheapest, best free-tier limits)  <-- recommended
#   gemini-flash-latest       (stronger, lower free RPM)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Phase 3 GCP settings (only used when BACKEND=gcp; see src/providers/gcp.py) ---
GCP_PROJECT=
GCP_LOCATION=us-central1
DOCAI_PROCESSOR_ID=
VECTOR_INDEX_ID=
VECTOR_ENDPOINT_ID=
